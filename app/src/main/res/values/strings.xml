    <!-- Settings tab — inference defaults -->
    <string name="settings_inference_hint">Used when the request doesn\'t specify temperature, top_k, or max_tokens.</string>
    <string name="settings_backend">Backend</string>
    <string name="settings_backend_hint">Changing the backend rebuilds the engine on the next request.</string>
    <string name="settings_backend_auto">Auto</string>
    <string name="settings_backend_cpu">CPU</string>
    <string name="settings_backend_gpu">GPU</string>
    <string name="settings_backend_npu">NPU/TPU</string>
    <string name="settings_backend_desc_auto"><![CDATA[<b>Auto</b> <i>(recommended)</i> — tries NPU → GPU → CPU, no silent stop: every attempted step is recorded under <tt>GET /health</tt>\'s <tt>attempts</tt> field and the Console log so you can see exactly which backend resolved. On Google Tensor SoCs the GPU step is skipped (its <tt>nativeCreateEngine</tt> can SIGSEGV the service rather than throw a catchable error).]]></string>
    <string name="settings_backend_desc_cpu"><![CDATA[<b>CPU</b> — force <tt>Backend.CPU</tt>. Always works. ~6–12 tok/s on Pixel-class hardware for Gemma 4 E2B. On Tensor SoCs a one-shot NPU primer runs first (visible as <tt>NPU-primer=expected-fail</tt> in <tt>/health</tt>) — without it LiteRT-LM 0.12.0\'s CPU init throws.]]></string>
    <string name="settings_backend_desc_gpu"><![CDATA[<b>GPU</b> — force <tt>Backend.GPU</tt>. Strict — no silent fallback. On stock Pixel images this typically fails (Tensor G1: <tt>libvndksupport.so</tt> missing; Tensor G5: <tt>TF_LITE_AUX not found in the model</tt> — the stock Gemma 4 <tt>.litertlm</tt> wasn\'t compiled for the Tensor GPU path). Errors propagate to the caller so the failure is visible, not hidden.]]></string>
    <string name="settings_backend_desc_npu"><![CDATA[<b>NPU/TPU</b> — force <tt>Backend.NPU</tt>. Now public on the LiteRT NPU page. The Google Tensor dispatch lib (<tt>libLiteRtDispatch_GoogleTensor.so</tt>, 400 KB) ships in this APK\'s <tt>jniLibs/arm64-v8a/</tt> from <a href="https://github.com/google-ai-edge/LiteRT/releases">github.com/google-ai-edge/LiteRT</a>. It loads only if you also feed it a SoC-compiled model — e.g. <tt>gemma-4-E2B-it_Google_Tensor_G5.litertlm</tt> compiled via <tt>tooling/tensor-aot/</tt>. With a stock CPU/GPU <tt>.litertlm</tt>, NPU init fails with <tt>TF_LITE_AUX not found in the model</tt> (the model wasn\'t compiled for the TPU path). Sample devices report ~10× CPU speed on NPU.]]></string>
    <string name="settings_chipset_tensor">Your device: %1$s (Tensor). GPU delegate often fails; AUTO will fall back to CPU.</string>
    <string name="settings_chipset_snapdragon">Your device: %1$s (Snapdragon). NPU variant <tt>.litertlm</tt> files in the catalog should work — try them with backend AUTO.</string>
    <string name="settings_chipset_other">Your device: %1$s. AUTO is the safe choice.</string>
    <string name="settings_max_tokens">Max tokens</string>
    <string name="settings_max_tokens_help">Default cap on response length when the request omits max_tokens. Larger values use more memory and time.</string>
    <string name="settings_temperature">Temperature: %1$s</string>
    <string name="settings_temperature_help">Sampling temperature. 0 = deterministic / greedy. Higher values increase diversity.</string>
    <string name="settings_top_k">Top-K: %1$d</string>
    <string name="settings_top_k_help">Restrict sampling to the top-K most likely tokens. Lower = more focused, higher = more varied.</string>

